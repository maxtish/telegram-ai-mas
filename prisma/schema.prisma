generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь Telegram
model User {
  id           BigInt    @id
  username     String?
  firstName    String?
  languageCode String?   @default("ru")
  botState     String    @default("IDLE")
  
  // --- НОВЫЕ ПОЛЯ ДЛЯ ПАМЯТИ ---
  realName     String?   // Как пользователь просил его называть
  interests    String[]  // Массив интересов (например: ["мотоциклы", "3D печать", "астрономия"])
  about        String?   // Любые другие факты (работа, семья, привычки)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  persona      Persona?
  messages     Message[]
  vocabulary   Vocabulary[]
}

// Уникальная личность бота, сгенерированная для конкретного пользователя
model Persona {
  id               Int      @id @default(autoincrement())
  userId           BigInt   @unique
  name             String   // Имя бота (например, "Hans")
  age              Int
  profession       String
  city             String   // Город в Германии
  hobbies          String[] // Массив хобби
  communicationStyle String // Инструкция для промпта (как общаться)
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// История переписки
model Message {
  id        Int      @id @default(autoincrement())
  userId    BigInt
  sender    SenderRole
  content   String   @db.Text
  mediaUrl  String?  // Если отправлено фото или аудио
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Словарь для ИИ-Учителя (анализ ошибок и успехов)
model Vocabulary {
  id          Int      @id @default(autoincrement())
  userId      BigInt
  wordOrRule  String   
  translation String?  // <-- НОВОЕ: Перевод
  status      String   
  notes       String?  
  score       Int      @default(0) 
  nextReview  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SenderRole {
  USER
  BOT
}